SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://root:root@localhost:5432/social_media


ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_COMMAND_TIMEOUT=60
DB_CONNECT_TIMEOUT=10
DB_ECHO=false

# SMTP -  MailHog is default for testing purposes.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@social-media.local
SMTP_USE_TLS=false
